# Lakeloom dev stack — example environment (NFR-DEP-05).
# DEVELOPMENT ONLY. Every value below is a fixed, publicly known dev default.
# Never reuse any of them outside a local machine or CI.
#
# Optional: cp deploy/compose/.env.example deploy/compose/.env  (git-ignored)
# The compose file already defaults every value, so the stack runs without a .env.

# --- Host endpoints (fixed ports used by Tasks 8-10) ------------------------------
# OpenMetadata  http://localhost:8585
# Keycloak      http://localhost:8180   (issuer http://localhost:8180/realms/lakeloom)
# Gitea         http://localhost:3000
# Lakeloom      http://localhost:8000

# --- OpenMetadata --------------------------------------------------------------------
# Development only: OM quickstart default admin, used by om-bootstrap to read the bot JWT.
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin
OM_BOT_NAME=ingestion-bot
# Lakeloom (Task 8) reads the bot token from the om-secrets volume:
LAKELOOM_OM_URL=http://openmetadata-server:8585
LAKELOOM_OM_BOT_TOKEN_FILE=/secrets/om_bot_token

# --- Optional RDF (Fuseki) -----------------------------------------------------------
# Enable with: RDF_ENABLED=true docker compose -f deploy/compose/docker-compose.yml --profile rdf up -d
RDF_ENABLED=false
# Development only: Fuseki admin password (OM's upstream dev default).
FUSEKI_ADMIN_PASSWORD=admin
FUSEKI_OPENMETADATA_PASSWORD=openmetadata-secret
FUSEKI_JVM_ARGS=-Xms1g -Xmx1g

# --- Keycloak (realm `lakeloom`, imported from keycloak-realm.json) ------------------------
# Development only: Keycloak master-realm admin.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
LAKELOOM_OIDC_ISSUER=http://localhost:8180/realms/lakeloom
# Inside the compose network the issuer host is not reachable; fetch keys from here:
LAKELOOM_OIDC_JWKS_URL=http://keycloak:8080/realms/lakeloom/protocol/openid-connect/certs
LAKELOOM_OIDC_AUDIENCE=lakeloom
# Development only: fixed client secrets / users from the dev realm.
#   lakeloom-agent   (confidential, client_credentials)  secret dev-agent-secret
#   other-app        (confidential, NO lakeloom audience) secret dev-other-secret
#   lakeloom-dev-cli (public, PKCE S256 + password grant) users alice/alice, bob/bob
KC_AGENT_CLIENT_SECRET=dev-agent-secret
KC_OTHER_APP_CLIENT_SECRET=dev-other-secret

# --- Gitea -----------------------------------------------------------------------------
# Development only: admin created by gitea-init; repo lakeloom-admin/ontologies.
GITEA_ADMIN_USER=lakeloom-admin
GITEA_ADMIN_PASSWORD=lakeloom-admin
LAKELOOM_GIT_REMOTE=http://gitea:3000/lakeloom-admin/ontologies.git

# --- Lakeloom state store (PostgreSQL) ------------------------------------------------------
# Development only: role + database created in the OM postgres by lakeloom-db-init.sql.
# This URL is for the Lakeloom container (the app converts it to asyncpg). Postgres is also
# published on 127.0.0.1:5432 for contract tests:
#   LAKELOOM_TEST_DB_URL=postgresql://lakeloom:lakeloom@localhost:5432/lakeloom
LAKELOOM_DB_URL=postgresql://lakeloom:lakeloom@postgresql:5432/lakeloom
